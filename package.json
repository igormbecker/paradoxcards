{
  "name": "paradoxcards",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint:prettier:check": "prettier --check .",
    "prepare": "husky",
    "lint": "npm run lint:prettier:check && npm run lint:eslint:check",
    "lint:eslint:check": "eslint . --max-warnings 0",
    "commit": "cz",
    "lint:prettier:fix": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "setup:e2e": "playwright install --with-deps chromium",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "preview": "vite preview --host 0.0.0.0",
    "setup:env": "node infra/scripts/setup-env.mjs",
    "migrations:create": "node-pg-migrate --migrations-dir infra/migrations --migration-file-language cjs create",
    "services:wait:database": "node infra/scripts/wait-for-postgres.mjs",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:up": "docker compose -f infra/compose.yaml up -d database",
    "setup": "npm ci && npm run setup:env",
    "migrations:down": "node infra/scripts/migrate.mjs down",
    "services:down": "docker compose -f infra/compose.yaml down",
    "test:database": "npm run setup:env && docker compose -f infra/compose.yaml --profile test up -d database-test && node infra/scripts/wait-for-postgres.mjs test && node infra/database.integration.mjs",
    "migrations:up": "node infra/scripts/migrate.mjs up",
    "dev:client": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "dev": "npm run setup:env && npm run services:up && npm run services:wait:database && npm run migrations:up && npm run dev:client"
  },
  "dependencies": {
    "async-retry": "1.3.3",
    "dotenv": "18.0.5",
    "dotenv-expand": "1000.0.0",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "phaser": "3.90.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "npm": "11.19.1",
    "node": "24.22.1"
  },
  "packageManager": "npm@11.19.1"
}
